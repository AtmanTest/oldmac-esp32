# ESP32-S3-ePaper-1.54 / robot-mascotte Mino
# Minimal config derived from the Waveshare vendor defaults (ESP-IDF 5.5.1)
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y

# pas de Bluetooth : on est un robot WiFi, on garde la RAM
CONFIG_BT_ENABLED=n

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# SPIFFS : soul.md + memory.json
CONFIG_SPIFFS_MAX_PARTITIONS=3

# console : UART0 seul. La console serie USB est reprise par le pilote
# usb_serial_jtag, ce qui permet de taper des commandes a Mino (et de voir
# les logs) sans passer par le reseau.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=n

# TLS pour api.deepseek.com
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_LWIP_SNTP_MAX_SERVERS=1

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TLS_DYN_BUF_STRATEGY_SUPPORTED=y
CONFIG_FREERTOS_HZ=100


CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# CONFIG_MBEDTLS_HARDWARE_AES is not set

# gestion d'energie : le coeur descend a 80 MHz au repos et dort entre deux
# reveils du wifi (sans ca, la carte reste a 160 MHz en permanence)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
